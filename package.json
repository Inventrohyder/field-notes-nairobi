    "linkcheck": "node scripts/linkcheck.mjs dist",
    "pdf": "node scripts/make-pdf.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
