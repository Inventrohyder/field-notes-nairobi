---
import BaseLayout from '../components/BaseLayout.astro';
import Picker from '../components/home/Picker.astro';
import IdeaTile from '../components/home/IdeaTile.astro';
import HeroRoad from '../components/home/HeroRoad.astro';
import { GROUP_COLOURS } from '../components/home/group-colours';
import LegacyThumb from '../legacy/LegacyThumb.astro';
import { GROUPS, IDEAS, ideaById } from '../ideas/index';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const START = ['alert-timing', 'police-undivided', 'mosques'].map((id) => ideaById(id)!);
---

<BaseLayout
  title="Field Notes from Nairobi"
  description="Twenty-one small proposals from a volunteer map editor in Nairobi to make Waze fit Kenyan roads."
>
  <Fragment slot="nav">
    <a class="navlink" href="#ideas">
      All 21 ideas
    </a>
  </Fragment>

  <section class="greet wrap" data-greet hidden aria-labelledby="greet-h">
    <div class="greet-card">
      <p class="eyebrow">A note for you</p>
      <p id="greet-h" class="greet-line" data-greet-line>
        Hello
      </p>
      <ol class="tiles greet-tiles" data-greet-tiles></ol>
      <a class="btn primary greet-go" data-greet-go href={base}>
        Start here
      </a>
    </div>
  </section>

  <section class="hero" aria-labelledby="page-title">
    <div class="wrap hero-in">
      <div class="hero-text">
        <h1 id="page-title">
          <span>Field notes</span>
          <span>from Nairobi</span>
        </h1>
        <p class="thesis">
          Twenty-one small proposals from a volunteer map editor in Nairobi to make Waze fit Kenyan
          roads.
        </p>
        <p class="byline">
          <b>Haitham Alhad Hyder</b> · Volunteer map editor in Nairobi
        </p>
        <p class="hero-links">
          <a class="hero-pick" href="#pick" data-hero-pick hidden>
            Pick with stars
          </a>
          <a class="hero-all" href="#ideas">
            See all 21 ideas
          </a>
        </p>
      </div>
      <HeroRoad />
    </div>
  </section>

  <div class="wrap home">
    <section class="start" id="start" aria-labelledby="start-h">
      <h2 id="start-h">Short on time? Start with these three</h2>
      <ol class="start-list">
        {START.map((idea) => (
          <li>
            <a href={`${base}${idea.id}/`}>
              <div class="start-pic">
                <LegacyThumb id={idea.id} />
              </div>
              <span class="start-t">
                <span class="num">{idea.num}</span>
                <b>{idea.title}</b>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p>
        <a
          class="btn"
          href={`${base}${START[0].id}/?tour=${START.map((s) => s.id).join(',')}`}
          data-start-tour
        >
          Walk me through these three
        </a>
      </p>
    </section>

    <Picker />

    <section class="all" id="ideas" aria-labelledby="ideas-h">
      <h2 id="ideas-h">All 21 ideas</h2>
      {GROUPS.map((g) => {
        const ideas = IDEAS.filter((i) => i.group === g.id);
        return (
          <section class="grp" id={`g-${g.id}`} aria-labelledby={`gh-${g.id}`}>
            <h3 class="grp-h" id={`gh-${g.id}`}>
              <span class="grp-chip" style={`--c: ${GROUP_COLOURS[g.id]}`} aria-hidden="true" />
              {g.name}
            </h3>
            <ul class="tiles">
              {ideas.map((i) => (
                <IdeaTile idea={i} level={4} />
              ))}
            </ul>
          </section>
        );
      })}
    </section>

    <section class="about" id="about" aria-labelledby="about-h">
      <h2 id="about-h">About</h2>
      <p>
        I'm Haitham Alhad Hyder, a software engineer in Nairobi and a volunteer Waze map editor (WME
        and Waze Discuss: Inventrohyder). This is a community member's proposal and carries no Waze
        endorsement.
      </p>
      <p>I would be glad to help test any of these with the Nairobi editing community.</p>
      <ul class="about-notes">
        <li>First shown to Waze staff at the EMEA Mega Meetup in Berlin, October 2026.</li>
        <li>Screenshots are my own, from drives in Kenya, with plates and names blurred.</li>
        <li>Scenes and phone screens are original drawings. None is a Waze screen.</li>
        <li>Numbers link to sources checked in October 2026. Made-up examples say Illustration.</li>
      </ul>
      <p class="keep-links">
        <a class="btn primary" href={`${base}field-notes-nairobi.pdf`}>
          Download the PDF
        </a>
        <a class="btn" href={`${base}print/`}>
          Printable page
        </a>
        <a class="btn" href="https://github.com/Inventrohyder" rel="me">
          github.com/Inventrohyder
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>

<style>
  .navlink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    color: var(--tarmac-ink);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 8px;
  }
  .navlink:hover {
    background: var(--tarmac-2);
  }
  .hero {
    background: var(--tarmac);
    color: var(--tarmac-ink);
    border-bottom: 5px solid var(--yellow);
  }
  .hero-in {
    display: grid;
    gap: 18px;
    padding-top: 24px;
    padding-bottom: 22px;
    max-width: 1044px;
  }
  .hero-text {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  @media (min-width: 900px) {
    .hero-in {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 36px;
      padding-top: 36px;
      padding-bottom: 36px;
    }
  }
  .hero h1 {
    margin: 0;
    font-family: var(--f-stencil);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--yellow);
    font-size: clamp(3.1rem, 15vw, 6.4rem);
    line-height: 0.84;
    letter-spacing: 0.01em;
  }
  .hero h1 span {
    display: block;
  }
  .thesis {
    font-size: 1.2rem;
    font-weight: 700;
    max-width: 34ch;
    margin: 0;
  }
  .byline {
    margin: 0;
    color: var(--tarmac-muted);
    font-size: 0.95rem;
  }
  .byline b {
    color: var(--tarmac-ink);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font: 700 0.8rem/1 var(--f-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero-pick {
    background: var(--yellow);
    color: #14181a;
  }
  .hero-pick:hover {
    background: var(--sign-yellow);
  }
  .hero-all {
    color: var(--tarmac-ink);
    border: 2px solid var(--tarmac-muted);
  }
  .hero-all:hover {
    border-color: var(--tarmac-ink);
  }
  .home {
    max-width: 1044px;
    display: grid;
    gap: 36px;
    padding-top: 24px;
  }
  .greet {
    max-width: 1044px;
    padding-top: 20px;
  }
  .greet-card {
    background: var(--surface);
    border: 2px solid var(--sign);
    border-radius: 18px;
    padding: 18px 16px;
    animation: greet-in 0.5s ease both;
  }
  @keyframes greet-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .greet-line {
    font: 700 1.35rem/1.3 var(--f-body);
    text-transform: none;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .greet-tiles {
    margin: 12px 0 14px;
  }
  .start h2 {
    margin-bottom: 12px;
  }
  .start-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: grid;
    gap: 10px;
  }
  .start-list a {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 12px;
    align-items: center;
    height: 100%;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 6px solid var(--yellow);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
  }
  .start-list a:hover {
    border-color: var(--sign);
    border-left-color: var(--yellow);
  }
  .start-pic {
    display: block;
    min-width: 0;
    aspect-ratio: 16 / 11;
  }
  .start-pic :global(.lg),
  .start-pic :global(.lg-thumb),
  .start-pic :global(.lg-thumb > div) {
    height: 100%;
  }
  .start-pic :global(.lg-thumb svg) {
    height: 100%;
  }
  .start-t {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .start-t b {
    font: 800 1.15rem/1.1 var(--f-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  @media (min-width: 760px) {
    .start-list {
      grid-template-columns: repeat(3, 1fr);
    }
    .start-list a {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
  .num {
    flex: none;
    align-self: flex-start;
    font: 700 0.85rem/1 var(--f-mono);
    background: var(--tarmac);
    color: var(--yellow);
    border-radius: 5px;
    padding: 6px;
  }
  .all h2 {
    margin-bottom: 4px;
  }
  .grp {
    margin-top: 18px;
  }
  .grp-h {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    padding: 8px 12px;
    font-size: 1.3rem;
    background: var(--sign);
    color: var(--sign-ink);
    border-radius: 10px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.85);
  }
  .grp-chip {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--c);
    box-shadow: 0 0 0 2px #fff;
  }
  .tiles,
  .home :global(.tiles) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media (min-width: 760px) {
    .tiles,
    .home :global(.tiles) {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
  .greet :global(.tiles) {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media (min-width: 760px) {
    .greet :global(.tiles) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .about {
    border-top: 3px dashed var(--rule);
    padding-top: 20px;
    max-width: 70ch;
  }
  .about-notes {
    color: var(--muted);
    font-size: 0.93rem;
    padding-left: 1.1em;
    margin: 0 0 12px;
  }
  .about-notes li {
    margin-bottom: 2px;
  }
  .keep-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
