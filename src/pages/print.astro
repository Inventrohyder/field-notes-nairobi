---
import BaseLayout from '../components/BaseLayout.astro';
import RulesBox from '../components/followup/RulesBox.astro';
import LegacyPrint from '../legacy/LegacyPrint.astro';
import LegacyThumb from '../legacy/LegacyThumb.astro';
import { GROUPS, IDEAS } from '../ideas/index';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/** Footnotes point at this page's own source lists. */
const local = (id: string, html: string) => html.replaceAll(`#src-${id}-`, `#p-src-${id}-`);
---

<BaseLayout
  title="Field Notes from Nairobi: every idea"
  description="All twenty-one ideas on one printable page, with sources."
  path="print/"
>
  <Fragment slot="nav">
    <a class="navlink" href={base}>
      All ideas
    </a>
  </Fragment>

  <div class="wrap print">
    <header class="cover">
      <h1>
        <span>Field notes</span>
        <span>from Nairobi</span>
      </h1>
      <div class="lane-line" aria-hidden="true"></div>
      <p class="thesis">
        Twenty-one small proposals from a volunteer map editor in Nairobi to make Waze fit Kenyan
        roads.
      </p>
      <p>First shown to Waze staff at the EMEA Mega Meetup in Berlin, October 2026.</p>
      <p>
        <b>Haitham Alhad Hyder</b> · Volunteer map editor in Nairobi
      </p>
      <p class="cover-note">
        Each idea starts on a new page, with what happens today and the proposal side by side.
        Numbers link to their sources, checked on 17 October 2026, and every source's address is
        printed. Anything made up to show an idea is marked Illustration. A community member's
        proposal. Not affiliated with or endorsed by Waze or Google.
      </p>
      <p class="cover-note">
        Online: inventrohyder.github.io/field-notes-nairobi · GitHub: github.com/Inventrohyder · WME
        and Waze Discuss: Inventrohyder
      </p>
      <ol class="toc">
        {GROUPS.map((g) => (
          <li>
            <b>{g.name}</b>
            <span>
              {IDEAS.filter((i) => i.group === g.id).map((i, k) => (
                <>
                  {k > 0 && ' · '}
                  <a href={`#p-${i.id}`}>
                    {i.num} {i.short}
                  </a>
                </>
              ))}
            </span>
          </li>
        ))}
      </ol>
    </header>

    {IDEAS.map((i) => (
      <article class="pi" id={`p-${i.id}`} aria-labelledby={`ph-${i.id}`}>
        <p class="eyebrow">
          <span class="pnum">{i.num}</span> {GROUPS.find((g) => g.id === i.group)?.name}
        </p>
        <h2 id={`ph-${i.id}`}>{i.title}</h2>
        <p class="hook">{i.hook}</p>
        <p set:html={local(i.id, i.problem)} />
        <p class="known">
          <b>You already know.</b> <Fragment set:html={local(i.id, i.known)} />
        </p>
        {i.moment && (
          <p class="moment">
            <b>The moment.</b> <Fragment set:html={local(i.id, i.moment.text)} />
          </p>
        )}

        {i.scenarios ? (
          <div class="fu">
            <div class="fu-pic">
              <LegacyThumb id={i.id} />
            </div>
            <div class="fu-steps">
              <section>
                <h3>1 · What happens today</h3>
                <Fragment set:html={local(i.id, i.howToday)} />
              </section>
              <section>
                <h3>
                  2 · What the call adds <span class="tag tag-proposed">Proposed</span>
                </h3>
                <Fragment set:html={local(i.id, i.howProposed)} />
              </section>
            </div>
            <RulesBox />
          </div>
        ) : (
          <div class="pair" data-pair={i.id}>
            <LegacyPrint id={i.id} />
          </div>
        )}

        {i.also && i.also.length > 0 && (
          <>
            <h3>It would also</h3>
            <ul>
              {i.also.map((a) => (
                <li set:html={local(i.id, a)} />
              ))}
            </ul>
          </>
        )}
        {i.why.length > 0 && (
          <>
            <h3>Why it matters</h3>
            <ul>
              {i.why.map((w) => (
                <li set:html={local(i.id, w)} />
              ))}
            </ul>
          </>
        )}
        <h3>Elsewhere</h3>
        <ul>
          {i.elsewhere.map((e) => (
            <li>
              {e.gap && <span class="tag tag-illus">Not found</span>}{' '}
              <Fragment set:html={local(i.id, e.text)} />
            </li>
          ))}
        </ul>
        {i.questions && i.questions.length > 0 && (
          <>
            <h3>Questions you will ask</h3>
            <dl class="qa">
              {i.questions.map((q) => (
                <div>
                  <dt>{q.q}</dt>
                  <dd set:html={local(i.id, q.a)} />
                </div>
              ))}
            </dl>
          </>
        )}
        <div class="ask">
          <h3>The ask</h3>
          <p set:html={local(i.id, i.ask)} />
          <p class="for">For: {i.teams.join(' · ')}</p>
        </div>
        <h3>Sources</h3>
        <ol class="src">
          {i.sources.map((s) => (
            <li id={`p-src-${i.id}-${s.n}`} value={s.n}>
              <a href={s.url}>{s.label}</a> <span class="url">{s.url}</span>
            </li>
          ))}
        </ol>
        <p class="online">Online: inventrohyder.github.io/field-notes-nairobi/{i.id}/</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .navlink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    color: var(--tarmac-ink);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 8px;
  }
  .print {
    max-width: 900px;
    padding-top: 24px;
  }
  .cover {
    background: var(--tarmac);
    color: var(--tarmac-ink);
    border-bottom: 5px solid var(--yellow);
    border-radius: 14px;
    padding: 22px 20px 12px;
  }
  .cover h1 {
    margin: 0 0 12px;
    font: 800 clamp(2.8rem, 12vw, 5rem) / 0.86 var(--f-stencil);
    text-transform: uppercase;
    color: var(--yellow);
  }
  .cover h1 span {
    display: block;
  }
  .lane-line {
    height: 5px;
    max-width: 420px;
    background: repeating-linear-gradient(90deg, var(--tarmac-ink) 0 30px, transparent 30px 50px);
    margin-bottom: 14px;
  }
  .thesis {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .cover-note {
    color: var(--tarmac-muted);
    font-size: 0.9rem;
  }
  .cover a {
    color: var(--sign-yellow);
  }
  .toc {
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
  }
  .toc li {
    margin-bottom: 6px;
  }
  .toc b {
    display: block;
  }
  .pi {
    border-top: 2px solid var(--rule);
    padding-top: 18px;
    margin-top: 28px;
  }
  .pi h2 {
    margin-bottom: 4px;
  }
  .pi h3 {
    font-size: 1.1rem;
    margin: 16px 0 6px;
  }
  .pnum {
    display: inline-block;
    background: var(--sign);
    color: var(--sign-ink);
    border-radius: 4px;
    padding: 3px 6px;
  }
  .hook {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .known {
    border-left: 4px solid var(--yellow);
    padding-left: 10px;
  }
  .pair {
    margin: 14px 0;
  }
  .fu {
    display: grid;
    gap: 12px;
    margin: 14px 0;
  }
  .fu-pic {
    max-width: 360px;
  }
  .fu-steps {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 700px) {
    .fu-steps {
      grid-template-columns: 1fr 1fr;
    }
    .fu-steps :global(p) {
      font-size: 9.2pt;
    }
    .fu-pic {
      max-width: 82mm;
    }
  }
  .fu-steps section {
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 0 12px;
    background: var(--surface);
  }
  .fu-steps :global(p) {
    font-size: 0.92rem;
  }
  .qa dt {
    font-weight: 700;
  }
  .qa dd {
    margin: 0 0 8px;
  }
  .ask {
    background: var(--surface);
    border-left: 6px solid var(--yellow);
    border-radius: 0 10px 10px 0;
    padding: 2px 12px 2px;
    margin-top: 14px;
  }
  .ask h3 {
    margin-top: 10px;
  }
  .ask p:first-of-type {
    font-weight: 700;
  }
  .for {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .src {
    font-size: 0.85rem;
  }
  .url {
    display: none;
    word-break: break-all;
  }
  .online {
    display: none;
  }
  @media print {
    @page {
      size: A4;
      margin: 12mm 13mm 14mm;
    }
    .print {
      max-width: none;
      padding: 0;
      font-size: 9.6pt;
      line-height: 1.42;
    }
    .cover {
      border-radius: 0;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .pi {
      break-before: page;
      border-top: 0;
      margin-top: 0;
      padding-top: 0;
    }
    .pi h2 {
      font-size: 20pt;
    }
    .pi h3 {
      font-size: 11pt;
      margin: 10px 0 4px;
      break-after: avoid;
    }
    .pi p,
    .pi li {
      orphans: 2;
      widows: 2;
    }
    .pair,
    .fu-pic,
    .ask {
      break-inside: avoid;
    }
    .fu-steps {
      grid-template-columns: 1fr 1fr;
    }
    .fu-steps :global(p) {
      font-size: 9.2pt;
    }
    .fu-pic {
      max-width: 82mm;
    }
    .url {
      display: inline;
      color: #4b5559;
      font-size: 7.5pt;
    }
    .src {
      font-size: 8pt;
    }
    .online {
      display: block;
      font-size: 8pt;
      color: #4b5559;
    }
    a {
      color: #0a6b4c;
    }
    :global(.topbar),
    :global(.skip),
    :global(.sitefoot) {
      display: none !important;
    }
  }
</style>
