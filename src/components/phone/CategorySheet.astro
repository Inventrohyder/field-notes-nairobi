---
import { icon } from './icons';

export interface Tile {
  choice: string;
  label: string;
  icon: string;
  /** Steps on which this tile carries the blue ring of the default option. */
  defaultOn?: string;
  /** Steps on which this tile shows as picked. */
  selectedOn?: string;
}
interface Props {
  title: string;
  tiles: Tile[];
  /** 'pills' = Cancel and Report pills; 'cancel' = a plain Cancel; 'none' = no buttons. */
  footer?: 'pills' | 'cancel' | 'none';
  reportChoice?: string;
  cancelChoice?: string;
  cells?: boolean;
  center?: boolean;
  closeX?: boolean;
  grab?: boolean;
}
const {
  title,
  tiles,
  footer = 'pills',
  reportChoice = 'send',
  cancelChoice = 'cancel',
  cells = false,
  center = false,
  closeX = true,
  grab = false,
} = Astro.props;
const headingId = `sheet-${title.toLowerCase().replace(/[^a-z]+/g, '-')}-${Math.round(Math.random() * 1e6)}`;
---

<div class="ph-scrim" aria-hidden="true"></div>
<section class="ph-sheet" aria-labelledby={headingId}>
  {grab && <span class="ph-grab" aria-hidden="true"></span>}
  <div class:list={['ph-sheet-head', { center }]}>
    <h4 id={headingId}>{title}</h4>
    {
      closeX && (
        <span class="ph-x" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="18" height="18">
            <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </span>
      )
    }
  </div>
  <div class:list={['ph-grid', { cells }]}>
    {
      tiles.map((t) => (
        <button
          type="button"
          class="ph-tile"
          data-choice={t.choice}
          data-label={t.label}
          data-on-steps={t.defaultOn ?? t.selectedOn}
          data-on-class={t.defaultOn ? 'is-default' : t.selectedOn ? 'is-selected' : undefined}
        >
          <span class="disc">
            <Fragment set:html={icon(t.icon, cells ? 40 : 38)} />
            <span class="check" aria-hidden="true" />
          </span>
          <span>{t.label}</span>
        </button>
      ))
    }
  </div>
  {
    footer === 'pills' && (
      <div class="ph-pills">
        <button type="button" class="ph-pill grey" data-choice={cancelChoice} data-label="Cancel">
          Cancel
        </button>
        <button type="button" class="ph-pill blue" data-choice={reportChoice} data-label="Report">
          Report
        </button>
      </div>
    )
  }
  {
    footer === 'cancel' && (
      <button type="button" class="ph-text-btn" data-choice={cancelChoice} data-label="Cancel">
        Cancel
      </button>
    )
  }
</section>
