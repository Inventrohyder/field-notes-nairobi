---
/**
 * Simple, original map drawings in the light Waze-like style: grey blocks, white roads,
 * a purple route and a teal position arrow. Two example layouts.
 * - highway: a highway curving north past a park, with roadworks ahead (scenario A).
 * - junction: a straight road meeting Kenyatta Avenue (scenario B).
 * - westlands: Waiyaki Way in Westlands, for the red light and the parked car.
 */
interface Props {
  layout: 'highway' | 'junction' | 'westlands';
  /** junction: where you are and which route shows. */
  at?: 'approach' | 'junction' | 'past';
  cones?: boolean;
  parked?: boolean;
  label: string;
}
const { layout, at = 'approach', cones = false, parked = false, label } = Astro.props;
const you =
  layout === 'westlands'
    ? parked
      ? { x: 214, y: 150, r: 0 }
      : { x: 150, y: 300, r: 0 }
    : layout === 'highway'
      ? parked
        ? { x: 236, y: 92, r: 0 }
        : { x: 150, y: 330, r: -4 }
      : at === 'approach'
        ? { x: 150, y: 350, r: 0 }
        : at === 'junction'
          ? { x: 150, y: 236, r: 0 }
          : { x: 150, y: 120, r: 0 };
---

<svg viewBox="0 0 300 420" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
  {layout === 'westlands' ? (
    <g>
      <rect class="m-block" x="10" y="20" width="100" height="120" rx="4" />
      <rect class="m-block" x="10" y="250" width="100" height="80" rx="4" />
      <rect class="m-block" x="10" y="350" width="100" height="80" rx="4" />
      <rect class="m-block" x="190" y="250" width="110" height="180" rx="4" />
      <rect class="m-block" x="176" y="112" width="96" height="72" rx="6" />
      <rect class="m-park" x="190" y="20" width="110" height="60" rx="4" />
      <path class="m-casing" stroke-width="30" d="M-10 205 L310 205" />
      <path class="m-road" stroke-width="26" d="M-10 205 L310 205" />
      <path class="m-casing" stroke-width="34" d="M150 440 L150 -20" />
      <path class="m-road" stroke-width="30" d="M150 440 L150 -20" />
      {!parked && (
        <>
          <path class="m-route-edge" stroke-width="13" d="M150 440 L150 205 L320 205" />
          <path class="m-route" stroke-width="9" d="M150 440 L150 205 L320 205" />
          <g transform="translate(176 236)">
            <rect x="-8" y="-17" width="16" height="34" rx="5" fill="#4a5258" />
            <circle cy="-9" r="4.6" fill="#e5484d" />
            <circle cy="0" r="4.6" fill="#6c7479" />
            <circle cy="9" r="4.6" fill="#6c7479" />
          </g>
        </>
      )}
      <text class="m-label" x="200" y="226">
        Waiyaki Way
      </text>
      <text class="m-label" x="180" y="104">
        Westlands
      </text>
      {parked && (
        <g transform="translate(214 128)">
          <path
            d="M0 -26c10 0 18 8 18 18 0 13-18 30-18 30S-18 5-18 -8c0-10 8-18 18-18z"
            fill="#3d8ef0"
            stroke="#fff"
            stroke-width="2.5"
          />
          <text x="0" y="-2" text-anchor="middle" fill="#fff" style="font: 900 18px var(--f-ui)">
            P
          </text>
        </g>
      )}
    </g>
  ) : layout === 'highway' ? (
    <g>
      <rect class="m-park" x="-10" y="150" width="130" height="300" rx="10" />
      <rect class="m-block" x="196" y="200" width="70" height="56" rx="4" />
      <rect class="m-block" x="208" y="276" width="80" height="62" rx="4" />
      <rect class="m-block" x="196" y="360" width="90" height="70" rx="4" />
      <rect class="m-block" x="24" y="30" width="80" height="60" rx="4" />
      <rect class="m-block" x="260" y="120" width="60" height="50" rx="4" />
      <path class="m-casing" stroke-width="22" d="M-10 120 C80 112 150 112 320 140" />
      <path class="m-road" stroke-width="18" d="M-10 120 C80 112 150 112 320 140" />
      <path
        class="m-casing"
        stroke-width="34"
        d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
      />
      <path
        class="m-road"
        stroke-width="30"
        d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
      />
      {!parked && (
        <>
          <path
            class="m-route-edge"
            stroke-width="13"
            d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
          />
          <path
            class="m-route"
            stroke-width="9"
            d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
          />
        </>
      )}
      <text class="m-label-big" x="18" y="300">
        Uhuru Park
      </text>
      <text class="m-label" x="196" y="104" transform="rotate(8 196 104)">
        Kenyatta Ave
      </text>
      <text class="m-label" x="98" y="262" transform="rotate(-76 98 262)">
        Uhuru Hwy
      </text>
      {cones && (
        <g transform="translate(176 196)">
          <circle r="17" fill="#fff" stroke="#d58a2c" stroke-width="2.5" />
          <path
            d="M-3.5 -10h7l6 17h-19z"
            fill="#f08a3c"
            stroke="#3a3020"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path d="M-5 -3h10M-7 3h14" stroke="#fff" stroke-width="2.4" />
        </g>
      )}
      {parked && (
        <g transform="translate(236 70)">
          <path
            d="M0 -26c10 0 18 8 18 18 0 13-18 30-18 30S-18 5-18 -8c0-10 8-18 18-18z"
            fill="#3d8ef0"
            stroke="#fff"
            stroke-width="2.5"
          />
          <text x="0" y="-2" text-anchor="middle" fill="#fff" style="font: 900 18px var(--f-ui)">
            P
          </text>
        </g>
      )}
    </g>
  ) : (
    <g>
      <rect class="m-block" x="10" y="20" width="100" height="140" rx="4" />
      <rect class="m-block" x="190" y="20" width="100" height="70" rx="4" />
      <rect class="m-block" x="10" y="250" width="100" height="80" rx="4" />
      <rect class="m-block" x="190" y="250" width="110" height="80" rx="4" />
      <rect class="m-block" x="10" y="350" width="100" height="80" rx="4" />
      <rect class="m-block" x="190" y="350" width="110" height="80" rx="4" />
      <rect class="m-park" x="190" y="110" width="110" height="40" rx="4" />
      <path class="m-casing" stroke-width="30" d="M-10 205 L310 205" />
      <path class="m-road" stroke-width="26" d="M-10 205 L310 205" />
      <path class="m-casing" stroke-width="34" d="M150 440 L150 -20" />
      <path class="m-road" stroke-width="30" d="M150 440 L150 -20" />
      <path class="m-casing" stroke-width="22" d="M150 100 L310 100" />
      <path class="m-road" stroke-width="18" d="M150 100 L310 100" />
      {at !== 'past' ? (
        <>
          <path class="m-route-edge" stroke-width="13" d="M150 440 L150 205 L320 205" />
          <path class="m-route" stroke-width="9" d="M150 440 L150 205 L320 205" />
        </>
      ) : (
        <>
          <path class="m-route-edge" stroke-width="13" d="M150 440 L150 100 L320 100" />
          <path class="m-route" stroke-width="9" d="M150 440 L150 100 L320 100" />
        </>
      )}
      <text class="m-label" x="214" y="226">
        Kenyatta Ave
      </text>
      <text class="m-label" x="214" y="122">
        Harambee Ave
      </text>
      {at === 'junction' && (
        <g transform="translate(196 252)">
          <rect x="-2" y="0" width="4" height="34" fill="#8a949b" />
          <circle r="19" fill="#fff" stroke="#e5484d" stroke-width="5" />
          <path
            d="M-7 7V-1c0-3 2-5 5-5h7M2 -10l4 4-4 4"
            fill="none"
            stroke="#1d1d1b"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M-12 12L12 -12" stroke="#e5484d" stroke-width="4.5" stroke-linecap="round" />
        </g>
      )}
    </g>
  )}
  <g transform={`translate(${you.x} ${you.y}) rotate(${you.r})`}>
    <circle class="m-halo" r="26"></circle>
    {!parked && <path class="m-you" d="M0 -15 L11 11 L0 5 L-11 11 Z" />}
    {parked && <circle r="7" fill="#3d8ef0" stroke="#fff" stroke-width="2.5" />}
  </g>
</svg>
