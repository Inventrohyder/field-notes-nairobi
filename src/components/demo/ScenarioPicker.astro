---
import type { Scenario } from '../../scenario/types';
import Tag from '../Tag.astro';

interface Props {
  intro: string;
  scenarios: Scenario[];
}
const { intro, scenarios } = Astro.props;
---

<div class="picker" data-picker>
  <p class="picker-intro">{intro}</p>
  <div class="picker-cards">
    {
      scenarios.map((s, i) => (
        <article class="pcard">
          <p class="eyebrow">
            Scenario {String.fromCharCode(65 + i)} <Tag kind="example" label="Example drive" />
          </p>
          <h3 tabindex="-1">{s.title}</h3>
          <p>{s.who}</p>
          <button type="button" class="btn primary" data-start={s.id}>
            Play: {s.title.toLowerCase().replace(/^a /, '').replace(/^./, (c) => c.toUpperCase())}
          </button>
        </article>
      ))
    }
  </div>
</div>

<style>
  .picker-intro {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .picker-cards {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 700px) {
    .picker-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pcard {
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    box-shadow: 5px 5px 0 var(--sign);
  }
  .pcard h3 {
    margin-bottom: 6px;
    outline: none;
  }
  .pcard p:not(.eyebrow) {
    flex: 1;
  }
  .pcard .btn {
    align-self: flex-start;
  }
  .eyebrow {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
