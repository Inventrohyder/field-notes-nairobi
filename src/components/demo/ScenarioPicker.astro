---
import type { Scenario } from '../../scenario/types';
import ScenarioArt from '../followup/ScenarioArt.astro';

interface Props {
  intro: string;
  scenarios: Scenario[];
}
const { intro, scenarios } = Astro.props;
const ART = new Set(['hazard', 'map-issue']);
---

<div class="picker" data-picker>
  <p class="picker-intro">{intro}</p>
  <div class="picker-cards">
    {scenarios.map((s, i) => {
      const letter = String.fromCharCode(65 + i);
      return (
        <article class="pcard">
          {ART.has(s.id) ? (
            <ScenarioArt id={s.id} label={s.who} />
          ) : (
            <p class="pcard-who">{s.who}</p>
          )}
          <h3 tabindex="-1">
            <span class="pcard-l" aria-hidden="true">
              {letter}
            </span>
            <span class="visually-hidden">Scenario {letter}: </span>
            <span class="pcard-t">{s.title}</span>
          </h3>
          <button
            type="button"
            class="btn primary"
            data-start={s.id}
            aria-label={`Play ${letter}: ${s.title}`}
          >
            Play {letter}
          </button>
        </article>
      );
    })}
  </div>
  <p class="picker-note">Illustration: the drives, places and times are examples.</p>
</div>

<style>
  .picker-intro {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .picker-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 640px;
  }
  .pcard {
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 4px 4px 0 var(--sign);
  }
  .pcard h3 {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.15;
    outline: none;
    flex: 1;
  }
  .pcard-l {
    flex: none;
    font: 700 0.8rem/1 var(--f-mono);
    background: var(--tarmac);
    color: var(--yellow);
    border-radius: 4px;
    padding: 4px 6px;
  }
  .pcard-who {
    flex: 1;
  }
  .pcard .btn {
    width: 100%;
    justify-content: center;
  }
  .picker-note {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
