---
import '../styles/global.css';
import { IDEAS } from '../ideas/index';
import Presenter from './Presenter.astro';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site base, used for the canonical link. */
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base + path, Astro.site).href;
const ideaMeta = JSON.stringify(
  IDEAS.map((i) => ({ id: i.id, num: i.num, title: i.title, short: i.short })),
).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#23272a" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link
      rel="preload"
      href={`${base}fonts/atkinson-hyperlegible-next-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={`${base}fonts.css`} />
    <script is:inline>
      try {
        const t = localStorage.getItem('field-notes-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {
        /* storage unavailable */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="topbar no-print">
      <div class="wrap topbar-in">
        <a class="brand" href={base}>
          <span class="brand-a">Field Notes</span>
          <span class="brand-b">from Nairobi</span>
        </a>
        <nav class="topnav" aria-label="Site">
          <slot name="nav" />
          <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor"></path>
            </svg>
            <span data-theme-label>Dark</span>
          </button>
        </nav>
      </div>
    </header>
    <script type="application/json" id="idea-meta" set:html={ideaMeta} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="sitefoot">
      <div class="wrap sitefoot-in">
        <slot name="footer" />
        <p class="disclaimer">
          A community member's proposal. Not affiliated with or endorsed by Waze or Google.
        </p>
        <p class="contact">
          <span>Haitham Alhad Hyder, volunteer map editor in Nairobi.</span>
          <a href="https://github.com/Inventrohyder" rel="me">
            GitHub: Inventrohyder
          </a>
          <span>WME and Waze Discuss: Inventrohyder</span>
        </p>
      </div>
    </footer>
    <Presenter />
    <script>
      import { initTheme } from '../scripts/theme';
      initTheme();
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker
          .register(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}sw.js`)
          .catch(() => {
            /* offline support is optional */
          });
      }
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--tarmac);
    color: var(--tarmac-ink);
    border-bottom: 3px solid var(--yellow);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .topbar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    color: var(--tarmac-ink);
    text-decoration: none;
    line-height: 1;
    min-height: 44px;
    justify-content: center;
  }
  .brand-a {
    font: 800 1.25rem/1 var(--f-stencil);
    text-transform: uppercase;
    color: var(--yellow);
    letter-spacing: 0.03em;
  }
  .brand-b {
    font: 600 0.8rem/1.1 var(--f-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tarmac-muted);
  }
  .topnav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: nowrap;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--tarmac-ink);
    font: 700 0.85rem/1 var(--f-body);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--tarmac-2);
  }
  @media (max-width: 480px) {
    [data-theme-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
  main {
    display: block;
    outline: none;
  }
  .sitefoot {
    margin-top: 48px;
    background: var(--tarmac);
    color: var(--tarmac-ink);
    padding: 28px 0 calc(28px + env(safe-area-inset-bottom, 0px));
    border-top: 3px dashed var(--yellow);
    font-size: 0.92rem;
  }
  .sitefoot a {
    color: var(--sign-yellow);
  }
  .disclaimer {
    font-weight: 700;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    color: var(--tarmac-muted);
    margin: 0;
  }
  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
