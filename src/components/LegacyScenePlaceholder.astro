---
/** Shown for ideas without guided scenarios until their scene is available. */
import type { IdeaEntry } from '../ideas/index';
interface Props {
  idea: IdeaEntry;
}
const { idea } = Astro.props;
---

<section class="legacy-ph" aria-labelledby={`${idea.id}-scene-h`}>
  <h2 id={`${idea.id}-scene-h`}>Today and proposed</h2>
  <div class="pair">
    <div>
      <p class="eyebrow">Today</p>
      <p set:html={idea.today} />
    </div>
    <div>
      <p class="eyebrow">Proposed</p>
      <p set:html={idea.proposed} />
    </div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 700px) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pair > div {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 14px;
  }
</style>
