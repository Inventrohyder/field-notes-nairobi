---
/** "Rules beside the phone" for the follow-up call (plan section 5). */

interface Props {
  /** A collapsed version for the narrator column, beside the phone while playing. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const RULES: [string, string][] = [
  ['Opt-in.', 'Only drivers who switch it on.'],
  ['Says it is AI.', 'Every call and text opens with “This is Waze’s AI assistant”.'],
  ['Parked only.', 'Never while moving or waiting in traffic.'],
  ['One callback.', 'If it is missed, one text follows, then nothing more.'],
  ['Three questions.', 'Under a minute.'],
  ['Questions that fit.', 'Lanes for roadworks, the turn for a map issue.'],
  ['Not for police or traffic.', 'Those reports expire within minutes.'],
];
---

{compact ? (
  <details class="rules compact">
    <summary>Rules beside the phone</summary>
    <ul>
      {RULES.map(([b, t]) => (
        <li>
          <b>{b}</b>
          {` ${t}`}
        </li>
      ))}
    </ul>
  </details>
) : (
  <aside class="rules" aria-labelledby="rules-h">
    <h3 id="rules-h">Rules beside the phone</h3>
    <ul>
      {RULES.map(([b, t]) => (
        <li>
          <b>{b}</b>
          {` ${t}`}
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .rules {
    background: var(--surface);
    border: 2px dashed var(--sign);
    border-radius: 14px;
    padding: 14px 16px 6px;
    margin-top: 16px;
  }
  .rules.compact {
    padding: 0 14px;
    margin-top: 10px;
    box-shadow: none;
  }
  .rules summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 700;
    color: var(--green-ink);
    cursor: pointer;
  }
  .rules.compact ul {
    padding-bottom: 8px;
  }
  .rules h3 {
    font-size: 1.1rem;
    color: var(--green-ink);
  }
  .rules ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rules li {
    padding: 6px 0 6px 26px;
    position: relative;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .rules li:first-child {
    border-top: 0;
  }
  .rules li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 12px;
    height: 7px;
    border-left: 3px solid var(--green-ink);
    border-bottom: 3px solid var(--green-ink);
    transform: rotate(-45deg);
  }
</style>
