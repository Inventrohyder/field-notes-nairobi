---
import Phone from '../phone/Phone.astro';
import TurnBanner from '../phone/TurnBanner.astro';
import Speedo from '../phone/Speedo.astro';
import ReportButton from '../phone/ReportButton.astro';
import EtaBar from '../phone/EtaBar.astro';
import CategorySheet from '../phone/CategorySheet.astro';
import DriveMap from '../phone/DriveMap.astro';
import { icon } from '../phone/icons';

const close = `<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>`;
const mic = `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
const proposed = '<span class="ph-tag proposed">Proposed</span>';
const illus = '<span class="ph-tag illus">Illustration</span>';
---

<Phone label="Example phone screen" clock="4:11">
  {/* Scenario A: driving up Uhuru Highway */}
  <div class="ph-screen" data-screen="drive-a" hidden>
    <TurnBanner dist="800 m" street="Uhuru Highway" turn="straight" />
    <div class="ph-map">
      <DriveMap
        layout="highway"
        cones
        label="Map: Uhuru Highway heading north past Uhuru Park, with roadworks ahead on the route."
      />
      <Speedo speed={52} />
      <ReportButton choice="report" />
    </div>
    <EtaBar arrive="4:26 pm" mins="15 min · 6.2 km" to="Sarit Centre" />
  </div>

  {/* Report menu, shared by both scenarios */}
  <div class="ph-screen" data-screen="menu" hidden>
    <TurnBanner dist="600 m" street="Uhuru Highway" turn="straight" muted />
    <div class="ph-map">
      <DriveMap layout="highway" cones label="Map behind the report menu." />
      <CategorySheet
        title="What do you see?"
        footer="none"
        grab
        tiles={[
          { choice: 'traffic', label: 'Traffic', icon: 'traffic' },
          { choice: 'police', label: 'Police', icon: 'police' },
          { choice: 'crash', label: 'Crash', icon: 'crash' },
          { choice: 'hazard', label: 'Hazard', icon: 'hazard' },
          { choice: 'weather', label: 'Bad weather', icon: 'weather' },
          { choice: 'blocked', label: 'Blocked lane', icon: 'blocked' },
          { choice: 'mapissue', label: 'Map issue', icon: 'mapissue' },
          { choice: 'closure', label: 'Closure', icon: 'closure' },
        ]}
      />
    </div>
  </div>

  {/* Hazard sub-types */}
  <div class="ph-screen" data-screen="hazard" hidden>
    <TurnBanner dist="500 m" street="Uhuru Highway" turn="straight" muted />
    <div class="ph-map">
      <DriveMap layout="highway" cones label="Map behind the hazard menu." />
      <CategorySheet
        title="Report a hazard"
        tiles={[
          { choice: 'hazard-default', label: 'Hazard', icon: 'hazard', defaultOn: 'a-hazard' },
          {
            choice: 'construction',
            label: 'Construction',
            icon: 'construction',
            selectedOn: 'a-hazard-picked',
          },
          { choice: 'car-shoulder', label: 'Car on shoulder', icon: 'shoulder' },
          { choice: 'traffic-light', label: 'Broken traffic light', icon: 'light' },
          { choice: 'pothole', label: 'Pothole', icon: 'pothole' },
          { choice: 'object', label: 'Object', icon: 'object' },
        ]}
      />
    </div>
  </div>

  {/* Reported, keep driving */}
  <div class="ph-screen" data-screen="reported-a" hidden>
    <TurnBanner dist="300 m" street="Uhuru Highway" turn="straight" />
    <div class="ph-map">
      <DriveMap
        layout="highway"
        cones
        label="Map: still driving on Uhuru Highway after the report."
      />
      <div class="ph-pill-note">
        Follow-up after you park <Fragment set:html={proposed} />
      </div>
      <div class="ph-toast" role="status">
        <Fragment set:html={icon('construction', 34)} />
        <div>
          Construction reported<small>Thanks for helping drivers nearby</small>
        </div>
      </div>
    </div>
    <EtaBar arrive="4:26 pm" mins="14 min · 5.7 km" to="Sarit Centre" />
  </div>

  {/* Red light: deliberate silence */}
  <div class="ph-screen" data-screen="red-a" hidden>
    <TurnBanner dist="150 m" street="Waiyaki Way" turn="keep-left" />
    <div class="ph-map">
      <DriveMap layout="highway" label="Map: stopped at a red light in Westlands." />
      <div class="ph-pill-note">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <rect x="7" y="2" width="10" height="20" rx="4" fill="#4a5258"></rect>
          <circle cx="12" cy="7" r="2.6" fill="#e5484d"></circle>
          <circle cx="12" cy="12" r="2.6" fill="#6c7479"></circle>
          <circle cx="12" cy="17" r="2.6" fill="#6c7479"></circle>
        </svg>
        Red light · no call while in traffic <Fragment set:html={proposed} />
      </div>
      <Speedo speed={0} />
      <ReportButton />
    </div>
    <EtaBar arrive="4:30 pm" mins="9 min · 2.1 km" to="Sarit Centre" />
  </div>

  {/* Parked, both scenarios */}
  <div class="ph-screen" data-screen="parked" hidden>
    <div class="ph-map">
      <DriveMap layout="highway" parked label="Map: your car parked at Sarit Centre, Westlands." />
      <div class="ph-parked">
        <h4>You’ve arrived</h4>
        <p>Sarit Centre, Westlands</p>
        <p>Engine off · parked for 2 min</p>
      </div>
    </div>
  </div>

  {/* Incoming call, both scenarios */}
  <div class="ph-screen" data-screen="incoming" hidden>
    <div class="ph-call">
      <div>
        <p class="label">
          <span data-hide-steps="a-callback b-callback">Incoming call</span>
          <span data-show-steps="a-callback b-callback" hidden>
            Calling back, as you asked
          </span>
          <Fragment set:html={proposed} />
        </p>
        <div class="ph-avatar">
          <Fragment set:html={icon('assistant', 40)} />
        </div>
        <p class="who">Waze AI assistant</p>
        <p class="why">
          <span data-sc="hazard" hidden>
            About the roadworks you reported at 4:11 pm · about 30 seconds
          </span>
          <span data-sc="map-issue" hidden>
            Map editors need a little more detail on the turn you reported at 4:11 pm · about 30
            seconds
          </span>
        </p>
      </div>
      <div style="width: 100%">
        <p class="ph-listen">
          <Fragment set:html={mic} />
          <span>
            Listening. Say “answer”, “text me” or
            <span data-hide-steps="a-callback b-callback">“call me later”.</span>
            <span data-show-steps="a-callback b-callback" hidden>
              “not now”.
            </span>
          </span>
        </p>
        <div class="ph-call-actions">
          <button type="button" class="ph-pill grey" data-choice="text" data-label="Text me">
            Text me
          </button>
          <button
            type="button"
            class="ph-pill grey"
            data-choice="later"
            data-label="Call me later"
            data-hide-steps="a-callback b-callback"
          >
            Call me later
          </button>
          <button
            type="button"
            class="ph-pill grey"
            data-choice="notnow"
            data-label="Not now"
            data-show-steps="a-callback b-callback"
            hidden
          >
            Not now
          </button>
          <button type="button" class="ph-pill green wide" data-choice="answer" data-label="Answer">
            Answer
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Call me later: when? */}
  <div class="ph-screen" data-screen="later" hidden>
    <div class="ph-lock">
      <p class="date">Example day</p>
      <p class="time" data-clock>
        4:31
      </p>
      <div class="ph-note">
        <div class="app">
          <span>Waze AI assistant</span>
          <span>now</span>
        </div>
        <b>When should I call back?</b>
        Tap one, or just say it: “in half an hour”, “this evening”.
        <div class="ph-chips" style="margin-top: 10px">
          <button type="button" class="ph-chip" data-choice="in30" data-label="In 30 minutes">
            In 30 minutes
          </button>
          <button type="button" class="ph-chip" data-choice="evening" data-label="This evening">
            This evening
          </button>
          <button
            type="button"
            class="ph-chip"
            data-choice="nextpark"
            data-label="Next time I park"
          >
            Next time I park
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Call me later: confirmed */}
  <div class="ph-screen" data-screen="later-set" hidden>
    <div class="ph-lock">
      <p class="date">Example day</p>
      <p class="time" data-clock>
        4:31
      </p>
      <div class="ph-note" role="status">
        <div class="app">
          <span>Waze AI assistant</span>
          <span>now</span>
        </div>
        <b>
          I’ll call back <span data-var="laterText"></span>.
        </b>
        One callback only. If you miss it, it becomes a text you can answer or ignore.
      </div>
    </div>
  </div>

  {/* Not now: ends it */}
  <div class="ph-screen" data-screen="notnow" hidden>
    <div class="ph-lock">
      <p class="date">Example day</p>
      <p class="time" data-clock>
        5:01
      </p>
      <div class="ph-note" role="status">
        <div class="app">
          <span>Waze AI assistant</span>
          <span>now</span>
        </div>
        <b>No problem. I won’t call again about this.</b>
        <span data-sc="hazard" hidden>
          Your report stays as it is, and the next driver who passes the spot is asked instead.
        </span>
        <span data-sc="map-issue" hidden>
          The map issue stays open for the editors, as it is today.
        </span>
      </div>
    </div>
  </div>

  {/* The conversation, call or text, both scenarios */}
  <div class="ph-screen" data-screen="convo" hidden>
    <div class="ph-convo-head">
      <span class="ph-avatar sm">
        <Fragment set:html={icon('assistant', 22)} />
      </span>
      <div>
        <b>Waze AI assistant</b>
        <span data-mode="call">On a call · voice</span>
        <span data-mode="text" hidden>
          Text messages
        </span>
      </div>
      <span class="end" data-mode="call">
        End
      </span>
    </div>
    <div class="ph-replay">
      <div class="replay-map" data-sc="hazard" hidden>
        <svg
          data-replay="hazard"
          viewBox="40 100 260 170"
          preserveAspectRatio="xMidYMid slice"
          role="img"
          aria-label="Replay of your drive up Uhuru Highway to the roadworks you reported."
        >
          <rect class="m-park" x="-10" y="150" width="130" height="300" rx="10"></rect>
          <rect class="m-block" x="196" y="200" width="70" height="56" rx="4"></rect>
          <path class="m-casing" stroke-width="22" d="M-10 120 C80 112 150 112 320 140"></path>
          <path class="m-road" stroke-width="18" d="M-10 120 C80 112 150 112 320 140"></path>
          <path
            class="m-casing"
            stroke-width="34"
            d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
          ></path>
          <path
            class="m-road"
            stroke-width="30"
            d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
          ></path>
          <path
            class="m-route"
            stroke-width="7"
            d="M150 440 C150 330 146 250 180 170 S 236 40 250 -20"
          ></path>
          <path
            data-replay-path
            fill="none"
            stroke="none"
            d="M150 300 C147 250 160 210 176 196"
          ></path>
          <g class="replay-spot" data-replay-done transform="translate(176 196)">
            <circle class="m-spot-ring" r="19"></circle>
            <path
              d="M-3.5 -10h7l6 17h-19z"
              fill="#f08a3c"
              stroke="#3a3020"
              stroke-width="1.8"
              stroke-linejoin="round"
            ></path>
          </g>
          <text class="m-label-big" x="48" y="250">
            Uhuru Park
          </text>
          <g data-replay-car transform="translate(150 300)">
            <circle class="m-halo" r="18"></circle>
            <path class="m-you" d="M0 -12 L9 9 L0 4 L-9 9 Z"></path>
          </g>
        </svg>
      </div>
      <div class="replay-map" data-sc="map-issue" hidden>
        <svg
          data-replay="map-issue"
          viewBox="40 120 230 160"
          preserveAspectRatio="xMidYMid slice"
          role="group"
          aria-label="Replay of your drive up to the junction with Kenyatta Avenue. Tap the turn that was not allowed."
        >
          <rect class="m-block" x="10" y="20" width="100" height="160" rx="4"></rect>
          <rect class="m-block" x="190" y="250" width="110" height="80" rx="4"></rect>
          <rect class="m-block" x="10" y="250" width="100" height="80" rx="4"></rect>
          <path class="m-casing" stroke-width="30" d="M-10 205 L310 205"></path>
          <path class="m-road" stroke-width="26" d="M-10 205 L310 205"></path>
          <path class="m-casing" stroke-width="34" d="M150 440 L150 -20"></path>
          <path class="m-road" stroke-width="30" d="M150 440 L150 -20"></path>
          <path
            class="m-route"
            stroke-width="6"
            d="M150 440 L150 205 L320 205"
            opacity="0.8"
          ></path>
          <path
            class="m-driven"
            data-replay-trace
            stroke-width="6"
            d="M150 300 L150 120"
            pathLength="1"
            style="stroke-dasharray: 1; stroke-dashoffset: 1"
          ></path>
          <path data-replay-path fill="none" stroke="none" d="M150 300 L150 120"></path>
          <text class="m-label" x="200" y="194">
            Kenyatta Ave
          </text>
          <g class="replay-turns" data-replay-done>
            <g
              class="ph-turn"
              role="button"
              tabindex="-1"
              data-choice="turn-left"
              data-label="Left onto Kenyatta Avenue"
              transform="translate(104 205)"
            >
              <circle r="15"></circle>
              <path d="M7 0H-6M-1.5 -4.5L-6 0l4.5 4.5"></path>
            </g>
            <g
              class="ph-turn"
              role="button"
              tabindex="-1"
              data-choice="turn-straight"
              data-label="Straight on"
              transform="translate(150 160)"
            >
              <circle r="15"></circle>
              <path d="M0 7V-6M-4.5 -1.5L0 -6l4.5 4.5"></path>
            </g>
            <g
              class="ph-turn"
              role="button"
              tabindex="-1"
              data-choice="turn-right"
              data-label="Right onto Kenyatta Avenue"
              data-on-steps="b-why b-when"
              data-on-class="is-picked"
              transform="translate(196 205)"
            >
              <circle r="15"></circle>
              <path d="M-7 0H6M1.5 -4.5L6 0l-4.5 4.5"></path>
            </g>
          </g>
          <g data-replay-car transform="translate(150 300)">
            <circle class="m-halo" r="18"></circle>
            <path class="m-you" d="M0 -12 L9 9 L0 4 L-9 9 Z"></path>
          </g>
        </svg>
      </div>
      <span class="ph-replay-time">4:11 pm</span>
      <span
        class="ph-replay-cap"
        data-replay-cap
        data-sc="hazard"
        hidden
        data-done-text="You reported Construction here"
      >
        Replaying your drive
      </span>
      <span
        class="ph-replay-cap"
        data-replay-cap
        data-sc="map-issue"
        hidden
        data-done-text="You went straight on here"
      >
        Replaying your drive
      </span>
    </div>
    <div class="ph-transcript" data-transcript aria-live="off"></div>
    <div class="ph-answer">
      <div data-show-steps="a-call a-text" hidden>
        <div
          class="ph-lanes"
          role="group"
          aria-label="Lanes on Uhuru Highway. Tap every closed lane."
        >
          <button type="button" class="ph-lane" data-lane="Left" aria-pressed="false">
            <span>Left</span>
          </button>
          <button type="button" class="ph-lane" data-lane="Middle" aria-pressed="false">
            <span>Middle</span>
          </button>
          <button type="button" class="ph-lane" data-lane="Right" aria-pressed="false">
            <span>Right</span>
          </button>
        </div>
        <div class="ph-chips">
          <button
            type="button"
            class="ph-chip"
            data-choice="lanes-unsure"
            data-label="Couldn’t tell"
          >
            Couldn’t tell
          </button>
          <button type="button" class="ph-chip primary" data-choice="lanes-done" data-label="Done">
            Done
          </button>
        </div>
      </div>
      <div class="ph-chips" data-show-steps="a-q2" hidden>
        <button type="button" class="ph-chip" data-choice="dir-w">
          Towards Westlands
        </button>
        <button type="button" class="ph-chip" data-choice="dir-m">
          Towards Mombasa Road
        </button>
        <button type="button" class="ph-chip" data-choice="dir-b">
          Both directions
        </button>
      </div>
      <div class="ph-chips" data-show-steps="a-q3" hidden>
        <button type="button" class="ph-chip" data-choice="dur-today">
          Just today
        </button>
        <button type="button" class="ph-chip" data-choice="dur-days">
          A few days
        </button>
        <button type="button" class="ph-chip" data-choice="dur-weeks">
          Weeks or more
        </button>
        <button type="button" class="ph-chip" data-choice="dur-unsure">
          Couldn’t tell
        </button>
      </div>
      <p class="ph-hint" data-show-steps="b-call b-text" hidden>
        Tap the turn on the map above.
      </p>
      <div class="ph-chips" data-show-steps="b-why" hidden>
        <button type="button" class="ph-chip" data-choice="why-sign">
          No-turn sign
        </button>
        <button type="button" class="ph-chip" data-choice="why-barrier">
          Barrier
        </button>
        <button type="button" class="ph-chip" data-choice="why-oneway">
          One-way
        </button>
        <button type="button" class="ph-chip" data-choice="why-police">
          Police
        </button>
        <button type="button" class="ph-chip" data-choice="why-works">
          Roadworks
        </button>
        <button type="button" class="ph-chip" data-choice="why-unsure">
          Not sure
        </button>
      </div>
      <div class="ph-chips" data-show-steps="b-when" hidden>
        <button type="button" class="ph-chip" data-choice="when-all">
          All the time
        </button>
        <button type="button" class="ph-chip" data-choice="when-hours">
          Only at certain hours
        </button>
        <button type="button" class="ph-chip" data-choice="when-unsure">
          Not sure
        </button>
      </div>
    </div>
  </div>

  {/* Scenario A ending: what drivers approaching see */}
  <div class="ph-screen" data-screen="summary-a" hidden>
    <div class="ph-plain">
      <div class="ph-plain-head">
        What drivers approaching see now <Fragment set:html={proposed} />
      </div>
      <div class="ph-alert">
        <div class="ph-alert-top">
          <Fragment set:html={icon('construction', 40)} />
          <div>
            <b>Construction</b>Uhuru Highway · 400 m ahead
          </div>
        </div>
        <div class="ph-mini-lanes" aria-hidden="true">
          <i data-lane-mini="Left"></i>
          <i data-lane-mini="Middle"></i>
          <i data-lane-mini="Right"></i>
        </div>
        <dl class="ph-kv">
          <dt>Lanes</dt>
          <dd data-var="lanes"></dd>
          <dt>Direction</dt>
          <dd data-var="dir"></dd>
          <dt>How long</dt>
          <dd data-var="dur"></dd>
        </dl>
      </div>
      <div class="ph-plain-head">The next driver, just after passing</div>
      <div class="ph-alert">
        <div class="ph-alert-top">
          <Fragment set:html={icon('construction', 34)} />
          <div>
            <b>You just passed: Construction</b>Still there?
          </div>
        </div>
        <div class="ph-stack">
          <span class="ph-pill blue">Still there</span>
          <span class="ph-pill grey">Not there</span>
        </div>
      </div>
    </div>
  </div>

  {/* Scenario B: approaching the junction */}
  <div class="ph-screen" data-screen="drive-b" hidden>
    <TurnBanner dist="200 m" street="Kenyatta Ave" turn="right" />
    <div class="ph-map">
      <DriveMap
        layout="junction"
        at="approach"
        label="Map: the route turns right onto Kenyatta Avenue ahead."
      />
      <Speedo speed={38} />
      <ReportButton />
    </div>
    <EtaBar arrive="4:24 pm" mins="13 min · 5.4 km" to="Sarit Centre" />
  </div>

  <div class="ph-screen" data-screen="junction-b" hidden>
    <TurnBanner dist="30 m" street="Kenyatta Ave" turn="right" />
    <div class="ph-map">
      <DriveMap
        layout="junction"
        at="junction"
        label="Map: at the junction. A sign shows no right turn onto Kenyatta Avenue."
      />
      <div class="ph-pill-note">On the street: a no-right-turn sign</div>
      <Speedo speed={12} />
      <ReportButton />
    </div>
    <EtaBar arrive="4:24 pm" mins="12 min · 5.2 km" to="Sarit Centre" />
  </div>

  <div class="ph-screen" data-screen="recalc-b" hidden>
    <TurnBanner dist="250 m" street="Harambee Ave" turn="right" />
    <div class="ph-map">
      <DriveMap
        layout="junction"
        at="past"
        label="Map: past the junction. The new route turns right at the next road."
      />
      <div class="ph-pill-note">Route recalculated</div>
      <Speedo speed={34} />
      <ReportButton choice="report" />
    </div>
    <EtaBar arrive="4:26 pm" mins="14 min · 5.6 km" to="Sarit Centre" />
  </div>

  {/* Map issue sheet, exactly as today's app lists it */}
  <div class="ph-screen" data-screen="mapissue" hidden>
    <TurnBanner dist="200 m" street="Harambee Ave" turn="right" muted />
    <div class="ph-map">
      <DriveMap layout="junction" at="past" label="Map behind the map issue menu." />
      <CategorySheet
        title="Map Issue"
        cells
        center
        closeX={false}
        footer="cancel"
        tiles={[
          { choice: 'general', label: 'General map error', icon: 'general' },
          { choice: 'turn', label: 'Turn not allowed', icon: 'turnnot' },
          { choice: 'junction', label: 'Wrong junction', icon: 'junction' },
          { choice: 'address', label: 'Wrong address', icon: 'address' },
          { choice: 'bridge', label: 'Missing bridge or overpass', icon: 'bridge' },
          { choice: 'directions', label: 'Wrong driving directions', icon: 'directions' },
          { choice: 'exit', label: 'Missing exit', icon: 'exit' },
          { choice: 'road', label: 'Missing road', icon: 'road' },
        ]}
      />
    </div>
  </div>

  {/* Map issue: comment screen */}
  <div class="ph-screen" data-screen="comment" hidden>
    <TurnBanner dist="150 m" street="Harambee Ave" turn="right" muted />
    <div class="ph-sheet full ph-comment">
      <div class="ph-sheet-head" style="justify-content: flex-end">
        <span class="ph-x">
          <Fragment set:html={close} />
        </span>
      </div>
      <div class="ph-comment-top">
        <span class="disc">
          <Fragment set:html={icon('turnnot', 42)} />
        </span>
        <b>Turn not allowed</b>
      </div>
