---
/**
 * The idea's Field Notes scene: Today and Proposed toggle, its own controls and captions,
 * and a "Walk me through it" guided mode that follows the idea's sections.
 */
import './legacy.css';
import type { Idea } from '../ideas/types';
import { sceneHtml, glanceHtml, ideaData } from './scenes';

interface Props {
  id: string;
  /** The idea's short glance loop, with no walkthrough. */
  glance?: boolean;
}
const { id, glance = false } = Astro.props;
const raw = glance ? glanceHtml(id) : sceneHtml(id);
const idea: Idea | undefined = ideaData(id);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const MOTION_BTN =
  '<button type="button" class="motion-btn screen-only" data-motion-btn data-mb="pause" aria-label="Pause the moving picture" title="Pause">' +
  '<svg class="ic-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="3" height="9" rx="1"/><rect x="7" y="1.5" width="3" height="9" rx="1"/></svg>' +
  '<svg class="ic-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"/></svg>' +
  '<svg class="ic-replay" viewBox="0 0 12 12" aria-hidden="true"><path d="M10.2 6.3A4.2 4.2 0 1 1 8.9 3.1M9.3 0.9v2.6H6.7"/></svg>' +
  '<span class="mb-label">Pause</span></button>';
const plain = (h: string) =>
  h
    .replace(/<sup[\s\S]*?<\/sup>/g, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();

let html = raw ?? '';
if (raw && idea) {
  // One row above the picture: Today or Proposed, and Pause. Walk me through it sits under it.
  html = html
    .replace(/<span class="seg-hint">[^<]*<\/span>/, '')
    .replace(/<button type="button" class="motion-btn[\s\S]*?<\/button>/, '')
    .replace(/(aria-pressed="false">Proposed<\/button><\/div>)/, `$1${MOTION_BTN}`);
  const walk = /<button type="button" class="foot-btn walk-btn[\s\S]*?<\/button>/.exec(html);
  if (walk) html = html.replace(walk[0], '');
  // The opening beat: what the visitor already knows, in the Today frame.
  const known = idea.knownShort ?? plain(idea.known);
  const beat =
    '<p class="beat" aria-hidden="true">' +
    `<span class="beat-t"><b>You already know</b> ${known}</span>` +
    '<span class="beat-p"><b>Proposed</b></span>' +
    '</p>';
  const summary =
    `<p class="vh"><span class="vh-loop">The picture plays on a loop. </span>You already know: ${known} Today: ${plain(idea.today)} ` +
    `Proposed: ${plain(idea.proposed)}</p>`;
  const firstPic = html.search(/<div class="(scene|qa-rows)">/);
  html = html.slice(0, firstPic) + beat + summary + html.slice(firstPic);
  const at = html.lastIndexOf('</div>');
  html =
    html.slice(0, at) + (walk ? `<div class="walk-row">${walk[0]}</div>` : '') + html.slice(at);
}

const story =
  idea && !glance
    ? JSON.stringify({
        id: idea.id,
        num: idea.num,
        title: idea.title,
        known: idea.known,
        problem: idea.problem,
        moment: idea.moment
          ? {
              text: idea.moment.text,
              shots: (idea.moment.shots ?? []).map((s) => ({ ...s, src: base + s.src })),
            }
          : undefined,
        also: idea.also ?? [],
        elsewhere: idea.elsewhere,
        questions: idea.questions ?? [],
        why: idea.why,
        ask: idea.ask,
        teams: idea.teams,
        sources: idea.sources,
      }).replace(/</g, '\\u003c')
    : '';
---

{raw && idea && glance && (
  <div class="lg lg-scene lg-glance">
    <Fragment set:html={html} />
  </div>
)}
{raw && idea && !glance && (
  <div class="lg lg-scene">
    <Fragment set:html={html} />
    <script type="application/json" data-lg-story set:html={story} />
    <dialog class="lg lg-story" aria-labelledby="lg-story-h">
      <div class="st-sheet">
        <div class="st-head">
          <div class="st-head-in">
            <button type="button" class="st-close" data-story-close>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
              <span>Close</span>
            </button>
            <p class="st-progress">
              <span data-st-idea></span>
            </p>
          </div>
          <div class="st-bars" data-st-bars aria-hidden="true"></div>
        </div>
        <div class="st-body" data-st-body>
          <div class="st-col" data-st-content></div>
        </div>
        <div class="st-foot">
          <div class="st-foot-in">
            <button type="button" class="btn-quiet st-back" data-st-back>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M10 3L5 8l5 5" />
              </svg>
              <span>Back</span>
            </button>
            <button type="button" class="btn-primary st-next" data-st-next>
              <span data-st-next-label>Next</span>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6 3l5 5-5 5" />
              </svg>
            </button>
          </div>
        </div>
        <div class="st-hold" data-st-hold hidden></div>
        <p class="vh" aria-live="polite" data-st-live></p>
      </div>
    </dialog>
  </div>
)}

<script>
  import { initLegacy } from './scene-engine';
  initLegacy();
</script>
